<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Widget extensions must be sandboxed. It needs no network and no files
         of its own: everything it renders arrives through the group container. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>74XZ56V5VY.group.me.andrey.ClaudeX</string>
    </array>
</dict>
</plist>
